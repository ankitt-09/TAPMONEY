# Copy to .env.local for local overrides. None of these are required in development.

# Production database (Neon / any Postgres). Leave unset locally to use PGlite in ./.data
DATABASE_URL=

# Login passcode AND the bearer token used by the iPhone Shortcut. Required in production.
APP_SECRET=

# Timezone used for "this month" / "today" boundaries
APP_TZ=Asia/Kolkata

# Display currency
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_LOCALE=en-IN
